{
    "name": "hex-tactic",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "format": "prettier --write \"**/*.{ts,tsx}\"",
        "typecheck": "tsc --noEmit",
        "preview": "vite preview",
        "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb",
        "spacetime:publish:local": "spacetime publish --server local",
        "spacetime:publish": "spacetime publish --server maincloud"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.2.8",
        "@react-three/drei": "^10.7.7",
        "@react-three/fiber": "^9.6.1",
        "@tailwindcss/vite": "^4.2.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.14.0",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.4.3",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "sonner": "^2.0.7",
        "spacetimedb": "^2.2.0",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^4.2.1",
        "three": "^0.184.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.0",
        "@types/node": "^25.6.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/three": "^0.184.1",
        "@vitejs/plugin-react": "^6.0.0",
        "eslint": "^10.3.0",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.6.0",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.57.1",
        "vite": "^8.0.0"
    }
}
